<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HitAnalyzer2.ViewModels"
        xmlns:views="using:HitAnalyzer2.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HitAnalyzer2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/HA2_icon.ico"
        Width="800" Height="450" MinWidth="450" MinHeight="150"
        Title="Hit Analyzer 2">

    <Window.Styles>
        <Style Selector="MenuItem.active">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Menu x:Name="SettingsMenu">
            <MenuItem Header="_Shooting" Click="ShowShootingSettings" Classes.active="{Binding #ShootingSettings.IsVisible}" />
            <MenuItem Header="_Weapon" Click="ShowWeaponSettings" Classes.active="{Binding #WeaponSettings.IsVisible}" />
            <MenuItem Header="_Target" Click="ShowTargetSettings" Classes.active="{Binding #TargetSettings.IsVisible}" />
            <MenuItem Header="_Camera" Click="ShowCameraSettings" Classes.active="{Binding #CameraSettings.IsVisible}" />
            <MenuItem Header="_Detection" Click="ShowDetectionSettings" Classes.active="{Binding #DetectionSettings.IsVisible}" />
            <MenuItem Header="_About" Click="ShowAbout" Classes.active="{Binding #About.IsVisible}" />
        </Menu>
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
            <StackPanel x:Name="SessionElapsed" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        Margin="0,0,12,0" HorizontalAlignment="Right" IsHitTestVisible="False">
                <TextBlock Text="Time:" FontSize="32" />
                <TextBlock Text="{Binding ShootingSettings.SessionElapsedText}"
                           Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" />
            </StackPanel>
            <Grid x:Name="CameraPreview" Grid.Row="1" Grid.Column="1">
                <Image x:Name="PreviewImage" Source="{Binding CameraPreview.WebcamImage}" Stretch="Uniform"
                       StretchDirection="DownOnly" />
                <TextBlock Text="{Binding CameraPreview.StatusMessage}" TextWrapping="Wrap" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CameraPreview.FpsText}" Foreground="{DynamicResource SuccessTextBrush}" Background="{DynamicResource SuccessSurfaceBrush}"
                           Margin="10" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsVisible="{Binding CameraPreview.FpsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <views:CameraCalibrationOverlay x:Name="CalibrationOverlay" IsVisible="False" />
            </Grid>
            <Grid x:Name="InformationPanel" Grid.Column="1" Grid.RowSpan="3" IsVisible="False">
                <views:AboutView x:Name="AboutContent" />
                <views:HelpView x:Name="HelpContent" IsVisible="False" />
            </Grid>
            <StackPanel x:Name="HitCounter" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,10,10">
                <TextBlock Text="Score:" FontSize="32" />
                <TextBlock x:Name="RecordedScore" Text="{Binding ShootingSettings.LastHitScore}"
                           Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0" />
                <TextBlock x:Name="WeaponPreviewScore" Text="{Binding CameraPreview.WeaponPreviewScore, TargetNullValue='—'}"
                           Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0"
                           IsVisible="False" />
                <TextBlock Text="Hits:" FontSize="32" />
                <TextBlock Text="{Binding ShootingSettings.HitCount}" Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0" />
                <TextBlock Text="Total:" FontSize="32" />
                <TextBlock Text="{Binding ShootingSettings.TotalScore}" Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" MinWidth="72" />
            </StackPanel>
            <Border x:Name="SettingsPanel" Grid.RowSpan="3" Width="280" BorderThickness="0,0,1,0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <Grid>
                            <views:CameraSettingsView x:Name="CameraSettings" IsVisible="False"
                                                      DataContext="{Binding CameraSettings}" />
                            <views:DetectionSettingsView x:Name="DetectionSettings" IsVisible="False"
                                                         DataContext="{Binding DetectionSettings}" />
                            <views:WeaponSettingsView x:Name="WeaponSettings" IsVisible="False"
                                                      DataContext="{Binding WeaponSettings}" />
                            <views:ShootingSettingsView x:Name="ShootingSettings"
                                                        DataContext="{Binding ShootingSettings}" />
                            <views:TargetSettingsView x:Name="TargetSettings" IsVisible="False"
                                                      DataContext="{Binding TargetSettings}" />
                            <StackPanel x:Name="About" IsVisible="False" Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Theme" />
                                    <ComboBox ItemsSource="{Binding ShootingSettings.ThemeOptions}"
                                              SelectedIndex="{Binding ShootingSettings.SelectedThemeIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="Application theme"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button Content="Help (F1)" Click="ShowHelp" />
                                <Button Content="Help (html)" Click="ShowHtmlHelp" />
                                <Button Content="About" Click="ShowAbout" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConfigurationMessage}" TextWrapping="Wrap"
                                   IsVisible="{Binding ConfigurationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</Window>
