<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HitAnalyzer2.ViewModels"
        xmlns:views="using:HitAnalyzer2.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HitAnalyzer2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/HA2_icon.ico"
        Width="800" Height="600" MinWidth="800" MinHeight="600"
        Title="Hit Analyzer 2">

    <Window.Styles>
        <Style Selector="MenuItem.active">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Menu x:Name="SettingsMenu" IsEnabled="{Binding ShootingSettings.IsTabSwitchingEnabled}">
            <MenuItem Header="_Shooting" Click="ShowShootingSettings" Classes.active="{Binding #ShootingSettings.IsVisible}" />
            <MenuItem Header="_Weapon" Click="ShowWeaponSettings" Classes.active="{Binding #WeaponSettings.IsVisible}" />
            <MenuItem Header="_Target" Click="ShowTargetSettings" Classes.active="{Binding #TargetSettings.IsVisible}" />
            <MenuItem Header="_Camera" Click="ShowCameraSettings" Classes.active="{Binding #CameraSettings.IsVisible}" />
            <MenuItem Header="_Detection" Click="ShowDetectionSettings" Classes.active="{Binding #DetectionSettings.IsVisible}" />
            <MenuItem Header="App_Link" Click="ShowAppLink" Classes.active="{Binding #AppLink.IsVisible}" />
            <MenuItem Header="_About" Click="ShowAbout" Classes.active="{Binding #About.IsVisible}" />
        </Menu>
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
            <Grid x:Name="SessionElapsed" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                  Margin="12,0" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" IsVisible="{Binding ShootingSettings.IsSessionComplete}">
                    <TextBlock Text="Session complete" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="{Binding ShootingSettings.SessionCompletionReason}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Time:" FontSize="32" />
                    <TextBlock Text="{Binding ShootingSettings.SessionElapsedText}"
                               Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
            <Grid x:Name="CameraPreview" Grid.Row="1" Grid.Column="1">
                <Image x:Name="PreviewImage" Source="{Binding CameraPreview.WebcamImage}" Stretch="Uniform"
                       StretchDirection="Both" />
                <TextBlock Text="{Binding CameraPreview.StatusMessage}" TextWrapping="Wrap" Margin="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CameraPreview.FpsText}" Foreground="{DynamicResource SuccessTextBrush}" Background="{DynamicResource SuccessSurfaceBrush}"
                           Margin="10" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsVisible="{Binding CameraPreview.FpsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <views:CameraCalibrationOverlay x:Name="CalibrationOverlay" IsVisible="False" />
                <Grid x:Name="SessionStartOverlay" RowDefinitions="*,Auto" IsHitTestVisible="False">
                    <Border Grid.RowSpan="2" Background="{DynamicResource AppBackgroundBrush}"
                            IsVisible="{Binding ShootingSettings.IsSessionComplete}" />
                    <Border
                            IsVisible="{Binding ShootingSettings.IsSessionComplete}">
                        <Image x:Name="ResultTargetImage" Source="{Binding SessionResultsImage}"
                               Stretch="Uniform" StretchDirection="Both"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <WrapPanel x:Name="ResultStatistics" Grid.Row="1"
                          Orientation="Horizontal" HorizontalAlignment="Center"
                          IsVisible="{Binding ShootingSettings.IsSessionComplete}">
                        <Border x:Name="ResultGroupLegend" MaxWidth="300" Margin="8" Padding="6"
                                Background="{DynamicResource PanelBrush}"
                                IsVisible="{Binding MeanHitGroupText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Cep50Text}" Foreground="{DynamicResource Cep50Brush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MeanHitGroupText}" Foreground="{DynamicResource MeanHitGroupBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SmallestHitGroupText}" Foreground="{DynamicResource SmallestHitGroupBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding SmallestHitGroupText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding MeanPointOfImpactText}" Foreground="{DynamicResource MeanHitGroupBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding MeanPointOfImpactText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ResultScoreHistogram"
                                Margin="8" Padding="6" Background="{DynamicResource PanelBrush}"
                                ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding ScoreHistogram}" AutomationProperties.Name="Score distribution">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScoreHistogramBin">
                                        <Grid RowDefinitions="60,Auto" MinWidth="14">
                                            <StackPanel VerticalAlignment="Bottom" Spacing="2">
                                                <TextBlock Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center" />
                                                <Border Width="8" Height="{Binding BarHeight}" HorizontalAlignment="Center"
                                                        Background="{DynamicResource AccentTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Score}" FontSize="11"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </WrapPanel>
                    <Viewbox x:Name="SessionStartCountdown" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="ShootingSettings.IsStartCountdownVisible" />
                                <Binding Path="ShootingSettings.IsSessionCompleteOverlayVisible" />
                            </MultiBinding>
                        </Viewbox.IsVisible>
                        <Grid Width="160" Height="160">
                            <Grid IsVisible="{Binding ShootingSettings.IsStartCountdownVisible}">
                                <Border Background="{DynamicResource PanelBrush}" Opacity="0.85" />
                                <TextBlock Text="{Binding ShootingSettings.StartCountdown}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="128" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <Grid IsVisible="{Binding ShootingSettings.IsSessionCompleteOverlayVisible}">
                                <Border Background="{DynamicResource PanelBrush}" Opacity="0.85" />
                                <StackPanel Margin="8" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Session complete" TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AccentTextBrush}" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="{Binding ShootingSettings.SessionCompletionReason}"
                                               TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Grid>
            <Grid x:Name="InformationPanel" Grid.Column="1" Grid.RowSpan="3" IsVisible="False">
                <views:AboutView x:Name="AboutContent" />
                <views:HelpView x:Name="HelpContent" IsVisible="False" />
            </Grid>
            <StackPanel x:Name="HitCounter" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,10,10">
                    <TextBlock Text="Score:" FontSize="32" />
                    <TextBlock x:Name="RecordedScore" Text="{Binding ShootingSettings.LastHitScore}"
                               Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0" />
                    <TextBlock x:Name="WeaponPreviewScore" Text="{Binding CameraPreview.WeaponPreviewScore, TargetNullValue='0'}"
                               Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0"
                               IsVisible="False" />
                    <TextBlock Text="Hits:" FontSize="32" />
                    <TextBlock Text="{Binding ShootingSettings.HitCount}" Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" Margin="0,0,76,0" />
                    <TextBlock Text="Total:" FontSize="32" />
                    <TextBlock Text="{Binding ShootingSettings.TotalScore}" Foreground="{DynamicResource HitTextBrush}" FontSize="32" FontWeight="SemiBold" MinWidth="72" />
            </StackPanel>
            <Border x:Name="SettingsPanel" Grid.RowSpan="3" Width="280" BorderThickness="0,0,1,0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Border.Resources>
                    <x:Double x:Key="CheckBoxMinHeight">24</x:Double>
                    <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
                    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                    <GridLength x:Key="SliderPreContentMargin">5</GridLength>
                    <GridLength x:Key="SliderPostContentMargin">5</GridLength>
                </Border.Resources>
                <Border.Styles>
                    <Style Selector="CheckBox, Slider">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style Selector="Slider">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Slider /template/ Grid#HorizontalTemplate">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="TextBox.settingsInput, NumericUpDown">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="6,1" />
                    </Style>
                    <Style Selector="TextBox.settingsInput">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="NumericUpDown">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner, NumericUpDown /template/ TextBox#PART_TextBox">
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style Selector="Button, RepeatButton.settingsButton, ComboBox">
                        <Setter Property="Height" Value="24" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="8,1" />
                    </Style>
                </Border.Styles>
                <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4">
                        <Grid>
                            <views:CameraSettingsView x:Name="CameraSettings" IsVisible="False"
                                                      DataContext="{Binding CameraSettings}" />
                            <views:DetectionSettingsView x:Name="DetectionSettings" IsVisible="False"
                                                         DataContext="{Binding DetectionSettings}" />
                            <views:WeaponSettingsView x:Name="WeaponSettings" IsVisible="False"
                                                      DataContext="{Binding WeaponSettings}" />
                            <views:ShootingSettingsView x:Name="ShootingSettings"
                                                        DataContext="{Binding ShootingSettings}" />
                            <views:TargetSettingsView x:Name="TargetSettings" IsVisible="False"
                                                      DataContext="{Binding TargetSettings}" />
                            <views:AppLinkView x:Name="AppLink" IsVisible="False"
                                               DataContext="{Binding AppLink}" />
                            <StackPanel x:Name="About" IsVisible="False" Spacing="4">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Theme" />
                                    <ComboBox ItemsSource="{Binding ShootingSettings.ThemeOptions}"
                                              SelectedIndex="{Binding ShootingSettings.SelectedThemeIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="Application theme"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button Content="Help (F1)" Click="ShowHelp" />
                                <Button Content="Help (html)" Click="ShowHtmlHelp" />
                                <Button Content="About" Click="ShowAbout" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConfigurationMessage}" TextWrapping="Wrap"
                                   IsVisible="{Binding ConfigurationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</Window>
