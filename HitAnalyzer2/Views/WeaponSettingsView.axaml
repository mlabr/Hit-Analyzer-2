<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.WeaponSettingsView"
             x:DataType="vm:WeaponSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Weapon" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Weapon"
                  PlaceholderText="Select a weapon" ItemsSource="{Binding Weapons}"
                  SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WeaponSettingsViewModel+WeaponOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Trigger type:" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Trigger type"
                  ItemsSource="{Binding Triggers}"
                  SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}" />
        <TextBlock Text="Next detection interval (ms)" />
        <NumericUpDown Minimum="100" Maximum="5000" Increment="1" ShowButtonSpinner="False"
                       ClipValueToMinMax="True" ParsingNumberStyle="Integer" FormatString="0"
                       Value="{Binding NexDetectionInterval, Mode=TwoWay}"
                       AutomationProperties.Name="Next detection interval in millis" />
        <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="8">
            <TextBlock Text="Weapon offset (px)" />
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2" ColumnDefinitions="Auto,*,32,Auto" ColumnSpacing="4">
                <TextBlock Text="X" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="{Binding MinimumOffset}" Maximum="{Binding MaximumOffset}"
                        Height="22" MinHeight="0" VerticalAlignment="Center"
                        TickFrequency="1" SmallChange="1" IsSnapToTickEnabled="True"
                        Value="{Binding OffsetX, Mode=TwoWay}" AutomationProperties.Name="Weapon offset X" />
                <TextBlock Grid.Column="2" Text="{Binding OffsetX}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Reset" Command="{Binding ResetOffsetCommand}"
                        AutomationProperties.Name="Reset weapon offset"
                        Height="22" MinHeight="0" Padding="6,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding MinimumOffset}" Maximum="{Binding MaximumOffset}"
                        Height="22" MinHeight="0" VerticalAlignment="Center"
                        TickFrequency="1" SmallChange="1" IsSnapToTickEnabled="True"
                        Value="{Binding DisplayOffsetY, Mode=TwoWay}" AutomationProperties.Name="Weapon offset Y" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DisplayOffsetY}" VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="3" Content="ToCenter" Command="{Binding ToCenterCommand}"
                        Height="22" MinHeight="0" Padding="6,0" VerticalAlignment="Center" />
            </Grid>
            <Button Content="Save Weapon" Command="{Binding SaveWeaponCommand}" />
            <TextBlock Text="{Binding OffsetSettingsMessage}" TextWrapping="Wrap"
                       IsVisible="{Binding OffsetSettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
