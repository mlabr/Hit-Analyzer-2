<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             xmlns:views="using:HitAnalyzer2.Views"
             xmlns:models="using:HitAnalyzer2"
             x:Class="HitAnalyzer2.Views.WeaponSettingsView"
             x:DataType="vm:WeaponSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Weapon" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Weapon"
                  PlaceholderText="Select a weapon" ItemsSource="{Binding Weapons}"
                  SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WeaponProfileItem">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Caliber" />
        <Grid ColumnDefinitions="*,*">
            <TextBox Text="{Binding CaliberText, Mode=OneWay}" LostFocus="CommitCaliberOnLostFocus"
                     KeyDown="CommitCaliberOnEnter" AutomationProperties.Name="Caliber" />
            <TextBlock Grid.Column="1" Text="{Binding CaliberUnit}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="Trigger type:" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Trigger type"
                  ItemsSource="{Binding Triggers}"
                  SelectedItem="{Binding SelectedTrigger, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:TriggerTypeEnum">
                    <TextBlock Text="{Binding Converter={x:Static views:WeaponSettingsView.TriggerLabel}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Next detection interval (ms)" />
        <NumericUpDown Minimum="100" Maximum="5000" Increment="1" ShowButtonSpinner="False"
                       ClipValueToMinMax="True" ParsingNumberStyle="Integer" FormatString="0"
                       Value="{Binding NexDetectionInterval, Mode=TwoWay}"
                       AutomationProperties.Name="Next detection interval in millis" />
        <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="8">
            <TextBlock Text="Weapon offset (px)" />
            <Grid ColumnDefinitions="Auto,64" ColumnSpacing="8">
                <TextBlock Text="Offset zoom" VerticalAlignment="Center" />
                <ComboBox x:Name="OffsetZoomSelector" Grid.Column="1" SelectedIndex="0" MinWidth="0"
                          HorizontalAlignment="Stretch" AutomationProperties.Name="Offset zoom">
                    <ComboBoxItem Content="2×" />
                    <ComboBoxItem Content="4×" />
                    <ComboBoxItem Content="8×" />
                </ComboBox>
            </Grid>
            <views:CalibrationZoomView x:Name="OffsetZoomPreview" Height="180" IsHitTestVisible="False" />
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4" ColumnDefinitions="Auto,32,Auto,Auto,Auto" ColumnSpacing="4">
                <TextBlock Text="X" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OffsetX}" VerticalAlignment="Center" />
                <RepeatButton Grid.Column="2" Content="←" Command="{Binding NudgeOffsetCommand}" CommandParameter="Left"
                              AutomationProperties.Name="Move offset left one pixel" />
                <RepeatButton Grid.Column="3" Content="→" Command="{Binding NudgeOffsetCommand}" CommandParameter="Right"
                              AutomationProperties.Name="Move offset right one pixel" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSettings.OffsetStepText}" />
                <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayOffsetY}" VerticalAlignment="Center" />
                <RepeatButton Grid.Row="1" Grid.Column="2" Content="↑" Command="{Binding NudgeOffsetCommand}" CommandParameter="Up"
                              AutomationProperties.Name="Move offset up one pixel" />
                <RepeatButton Grid.Row="1" Grid.Column="3" Content="↓" Command="{Binding NudgeOffsetCommand}" CommandParameter="Down"
                              AutomationProperties.Name="Move offset down one pixel" />
                <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"
                           Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSettings.OffsetStepText}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Content="ToCenter" Command="{Binding ToCenterCommand}" HorizontalAlignment="Left" />
                <Button Grid.Column="1" Content="Reset" Command="{Binding ResetOffsetCommand}"
                        AutomationProperties.Name="Reset weapon offset" HorizontalAlignment="Right" />
            </Grid>
            <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
