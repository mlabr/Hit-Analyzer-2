<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="4">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="24,24,24,24" ColumnSpacing="8" RowSpacing="4">
            <TextBlock Text="Shooter" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Classes="settingsInput"
                     Text="{Binding Shooter, Mode=TwoWay}" AutomationProperties.Name="Shooter" />
            <TextBlock Grid.Row="1" Text="Target" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TargetSettings.SelectedTarget.Name, TargetNullValue='—'}" />
            <TextBlock Grid.Row="2" Text="Weapon" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WeaponSettings.SelectedWeapon.Name, TargetNullValue='—'}" />
            <TextBlock Grid.Row="3" Text="Caliber" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WeaponSettings.CaliberText}" />
                <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WeaponSettings.CaliberUnit}" />
            </StackPanel>
        </Grid>
        <CheckBox Content="Show all hits" IsChecked="{Binding ShowAllHits, Mode=TwoWay}" />
        <CheckBox Content="Show smallest 80% circle" IsChecked="{Binding ShowSmallestHitGroup, Mode=TwoWay}"
                  IsVisible="{Binding IsEnhancedR80Available}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsMonoscope}">
            <CheckBox IsChecked="{Binding IsHitLimitEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" AutomationProperties.Name="Hit Limits" />
            <TextBlock Text="Hit Limits" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding HitCountInitial, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Initial hit count" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsMonoscope}">
            <CheckBox IsChecked="{Binding IsTimeLimitEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" AutomationProperties.Name="Time Limit" />
            <TextBlock Text="Time Limit" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TimeLimitMinutes, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="35791394" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Time limit minutes" />
            <TextBlock Text="min" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TimeLimitSecondsPart, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="59" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Time limit seconds" />
            <TextBlock Text="s" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="Countdown" IsChecked="{Binding Countdown, Mode=TwoWay}"
                  IsEnabled="{Binding CanUseCountdown}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="Start Session" Command="{Binding StartSessionCommand}" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="Reset shooting" Command="{Binding ResetCommand}" />
        </Grid>
        <Border Padding="0,4">
            <StackPanel Spacing="4"
                        DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CameraPreview}"
                        x:DataType="vm:CameraPreviewViewModel">
                <StackPanel.Styles>
                    <Style Selector="Ellipse.ReadinessIndicator">
                        <Setter Property="Fill" Value="{DynamicResource DetectionWaitingBrush}" />
                    </Style>
                    <Style Selector="Ellipse.ReadinessIndicator.ready">
                        <Setter Property="Fill" Value="{DynamicResource DetectionReadyBrush}" />
                    </Style>
                    <Style Selector="Ellipse.ReadinessIndicator.tracking">
                        <Setter Property="Fill" Value="{DynamicResource DetectionTrackingBrush}" />
                    </Style>
                </StackPanel.Styles>
                <Grid ColumnDefinitions="19*,42*,19*">
                    <Ellipse Grid.Column="1" Height="{Binding $self.Bounds.Width}" Classes="ReadinessIndicator"
                             Classes.ready="{Binding IsDetectionReady}" Classes.tracking="{Binding IsDetectionTracking}" />
                </Grid>
                <TextBlock Text="{Binding DetectionReadiness}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>

</UserControl>
