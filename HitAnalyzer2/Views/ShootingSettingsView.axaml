<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="16">
        <TextBlock Text="Shooting settings" FontWeight="SemiBold" />
        <StackPanel Spacing="4">
            <TextBlock Text="Hits:" />
            <TextBlock Text="{Binding HitCount}" FontSize="32" FontWeight="SemiBold" />
            <Button Content="Reset" Command="{Binding ResetHitCountCommand}" />
        </StackPanel>
    </StackPanel>

</UserControl>
