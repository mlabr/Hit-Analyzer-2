<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             xmlns:views="using:HitAnalyzer2.Views"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="16">
        <TextBlock Text="Shooting settings" FontWeight="SemiBold" />
        <views:HitCounterView />
    </StackPanel>

</UserControl>
