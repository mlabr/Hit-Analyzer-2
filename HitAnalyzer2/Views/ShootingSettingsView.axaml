<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="16">
        <TextBlock Text="Shooting settings" FontWeight="SemiBold" />
        <Button Content="Reset hit count" Command="{Binding ResetHitCountCommand}" />
        <CheckBox Content="Show Target Preview" IsChecked="{Binding ShowTargetPreview, Mode=TwoWay}" />
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>

</UserControl>
