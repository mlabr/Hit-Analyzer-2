<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Theme" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"
                      AutomationProperties.Name="Application theme"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
        <CheckBox Content="Show all hits" IsChecked="{Binding ShowAllHits, Mode=TwoWay}" />
        <Button Content="Reset shooting" Command="{Binding ResetCommand}" />
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>

</UserControl>
