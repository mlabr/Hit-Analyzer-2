<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.ShootingSettingsView"
             x:DataType="vm:ShootingSettingsViewModel">

    <StackPanel Spacing="16">
        <CheckBox Content="Show all hits" IsChecked="{Binding ShowAllHits, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox IsChecked="{Binding IsHitLimitEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" AutomationProperties.Name="Hit Limits" />
            <TextBlock Text="Hit Limits" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding HitCountInitial, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="2147483647" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Initial hit count" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox IsChecked="{Binding IsTimeLimitEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" AutomationProperties.Name="Time Limit" />
            <TextBlock Text="Time Limit" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TimeLimitMinutes, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="35791394" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Time limit minutes" />
            <TextBlock Text="min" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TimeLimitSecondsPart, Mode=TwoWay}" Width="40" MinWidth="0"
                           Minimum="0" Maximum="59" Increment="1" FormatString="0"
                           ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Time limit seconds" />
            <TextBlock Text="s" VerticalAlignment="Center" />
        </StackPanel>
        <CheckBox Content="Countdown" IsChecked="{Binding Countdown, Mode=TwoWay}"
                  IsEnabled="{Binding IsTimeLimitEnabled}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="Start Session" Command="{Binding StartSessionCommand}" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="Reset shooting" Command="{Binding ResetCommand}" />
        </Grid>
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>

</UserControl>
