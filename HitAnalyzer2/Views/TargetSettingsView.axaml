<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             xmlns:views="using:HitAnalyzer2.Views"
             x:Class="HitAnalyzer2.Views.TargetSettingsView"
             x:DataType="vm:TargetSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Target" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Target"
                  PlaceholderText="Select a target" ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding LoadMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding CalibratedScaleText}" />
        <CheckBox Content="Adjust scale for distance"
                  IsChecked="{Binding AdjustScaleForDistance, Mode=TwoWay}" />
        <TextBlock Text="Calibration zoom" FontWeight="SemiBold" />
        <ComboBox x:Name="ZoomSelector" SelectedIndex="{Binding CalibrationZoomIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Calibration zoom">
            <ComboBoxItem Content="2×" />
            <ComboBoxItem Content="4×" />
            <ComboBoxItem Content="8×" />
        </ComboBox>
        <views:CalibrationZoomView x:Name="ZoomPreview" Height="180" IsHitTestVisible="False" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Text="Real distance (m)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.RealDistanceMeters, Mode=TwoWay}" Minimum="0.01"
                           Increment="1" ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Real distance in meters" />
            <TextBlock Grid.Row="1" Text="Simulated distance (m)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.SimulatedDistanceMeters, Mode=TwoWay}" Minimum="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.RealDistanceMeters}"
                           Increment="1" ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Simulated distance in meters" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="Save" HorizontalAlignment="Left"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
            <Button x:Name="ResetCalibrationButton" Grid.Column="1" Content="Reset calibration"
                    HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
    </StackPanel>
</UserControl>
