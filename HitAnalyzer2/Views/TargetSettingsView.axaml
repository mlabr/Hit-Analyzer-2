<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.TargetSettingsView"
             x:DataType="vm:CameraSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Calibration" FontWeight="SemiBold" />
        <Button x:Name="ResetCalibrationButton" Content="Reset to square" IsEnabled="False" />
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>
</UserControl>
