<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             xmlns:views="using:HitAnalyzer2.Views"
             x:Class="HitAnalyzer2.Views.TargetSettingsView"
             x:DataType="vm:TargetSettingsViewModel">
    <StackPanel Spacing="4" Grid.IsSharedSizeScope="True">
        <TextBlock Text="Select target" FontWeight="SemiBold" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Target"
                  PlaceholderText="Select a target" ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding LoadMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="Set four valid calibration corners." TextWrapping="Wrap"
                   IsVisible="{Binding NeedsMonoscopeCalibration}" />
        <Grid RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="TargetSettingLabel" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Physical distance" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" MinWidth="0"
                           Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.RealDistanceMeters, Mode=TwoWay}" Minimum="0.01"
                           Increment="1" ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Physical distance in meters" />
            <TextBlock Grid.Column="2" Text="(m)" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Simulated distance" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" MinWidth="0"
                           Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.SimulatedDistanceMeters, Mode=TwoWay}" Minimum="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShootingSettings.RealDistanceMeters}"
                           Increment="1" ClipValueToMinMax="True" ShowButtonSpinner="False"
                           AutomationProperties.Name="Simulated distance in meters" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="(m)" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding SimulatedScaleText}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="TargetSettingLabel" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Calibration zoom" VerticalAlignment="Center" />
            <ComboBox x:Name="ZoomSelector" Grid.Column="1" SelectedIndex="{Binding CalibrationZoomIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" MinWidth="0" AutomationProperties.Name="Calibration zoom">
                <ComboBoxItem Content="2×" />
                <ComboBoxItem Content="4×" />
                <ComboBoxItem Content="8×" />
            </ComboBox>
        </Grid>
        <views:CalibrationZoomView x:Name="ZoomPreview" Height="180" IsHitTestVisible="False" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="Save" HorizontalAlignment="Left"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
            <Button x:Name="ResetCalibrationButton" Grid.Column="1" Content="Reset calibration"
                    HorizontalAlignment="Right" IsEnabled="False" />
        </Grid>
    </StackPanel>
</UserControl>
