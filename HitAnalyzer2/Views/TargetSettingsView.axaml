<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             xmlns:views="using:HitAnalyzer2.Views"
             x:Class="HitAnalyzer2.Views.TargetSettingsView"
             x:DataType="vm:TargetSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Target" />
        <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Target"
                  PlaceholderText="Select a target" ItemsSource="{Binding Targets}"
                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding LoadMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding LoadMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="Calibration" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CalibratedScaleText}" />
        <Button x:Name="ResetCalibrationButton" Content="Reset calibration" IsEnabled="False" />
        <TextBlock Text="Calibration zoom" FontWeight="SemiBold" />
        <ComboBox x:Name="ZoomSelector" SelectedIndex="0" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Calibration zoom">
            <ComboBoxItem Content="2×" />
            <ComboBoxItem Content="3×" />
            <ComboBoxItem Content="4×" />
        </ComboBox>
        <views:CalibrationZoomView x:Name="ZoomPreview" Height="180" IsHitTestVisible="False" />
        <Button Content="Save" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveConfigurationCommand}" />
    </StackPanel>
</UserControl>
