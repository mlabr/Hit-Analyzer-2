<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.AudioSettingsView"
             x:DataType="vm:AudioSettingsViewModel">
    <StackPanel Spacing="8">
        <CheckBox Content="Enable audio" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
        <TextBlock Text="Hit sound effect" />
        <ComboBox HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Hit sound effect"
                  IsEnabled="{Binding IsEnabled}"
                  ItemsSource="{Binding Effects}"
                  SelectedItem="{Binding SelectedEffect, Mode=TwoWay}" />
        <StackPanel Spacing="4" IsEnabled="{Binding IsEnabled}">
            <CheckBox Content="Sound guided aiming" IsChecked="{Binding IsSgaEnabled}" />
            <StackPanel Spacing="4" IsEnabled="{Binding IsSgaEnabled}">
                <CheckBox Content="Stereo guidance" IsChecked="{Binding IsSgaStereo}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsSgaStereo}">
                    <TextBlock Text="Focus on:" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.Name="Focus on"
                              SelectedIndex="{Binding SgaFocusIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Target" />
                        <ComboBoxItem Content="Aim" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding AudioError}" IsVisible="{Binding HasAudioError}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
