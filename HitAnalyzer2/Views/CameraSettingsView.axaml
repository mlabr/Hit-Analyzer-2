<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HitAnalyzer2.ViewModels"
             x:Class="HitAnalyzer2.Views.CameraSettingsView"
             x:DataType="vm:CameraSettingsViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Webcam settings" FontWeight="SemiBold" />
        <ComboBox PlaceholderText="Select camera" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                  IsEnabled="{Binding !IsDiscoveringCameras}"
                  AutomationProperties.Name="CamSelected" />
        <ComboBox PlaceholderText="{Binding CameraModePlaceholder}" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CameraModes}" SelectedItem="{Binding SelectedCameraMode, Mode=TwoWay}"
                  IsEnabled="{Binding CanSelectCameraMode}"
                  AutomationProperties.Name="Výběr rozlišení a FPS" />
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CameraFlipOptions}" SelectedItem="{Binding SelectedCameraFlip, Mode=TwoWay}"
                  AutomationProperties.Name="Camera View Flip" />
        <Button Content="Refresh webcams" Command="{Binding RefreshCamerasCommand}"
                 IsEnabled="{Binding !IsDiscoveringCameras}" />

        <TextBlock Text="Calibration" />
        <ComboBox HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CalibrationModes}" SelectedItem="{Binding SelectedCalibrationMode, Mode=TwoWay}"
                  AutomationProperties.Name="Camera calibration" />

        <Button Content="Save webcam settings" Command="{Binding SaveCameraSettingsCommand}" />
        <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap"
                   IsVisible="{Binding SettingsMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

</UserControl>
